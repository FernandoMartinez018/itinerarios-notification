<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Ver nota de versión en itinerarios-airport-service/pom.xml. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.itinerarios</groupId>
    <artifactId>notification-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>notification-service</name>
    <description>Microservicio de notificaciones - Sistema de Itinerarios Personales</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.0.0</springdoc.version>
    </properties>

    <!--
        DECISIÓN (ver ADR-012-notification-runtime.md en itinerarios-docs):
        Para Nivel 2, Notification Service corre como una aplicación Spring Boot
        normal (consumidor RabbitMQ de larga duración), NO como AWS Lambda todavía.
        La sección 32 de la especificación maestra ya advierte que LocalStack no
        reproduce automáticamente la integración RabbitMQ -> Lambda, y que si se
        necesita algo ejecutable localmente, puede optarse por un consumer/adapter
        normal. El empaquetado como Lambda (imagen de contenedor, sección 58-59) se
        evalúa en Nivel 3, cuando corresponda el despliegue real en AWS.
    -->

    <!--
        Ajustes Spring Boot 4 (ADR-015, auditoría 2026-10-09):
        - spring-boot-starter-web -> spring-boot-starter-webmvc (nombre modular de Boot 4).
        - flyway-core -> spring-boot-starter-flyway: en Boot 4 la autoconfiguración de
          Flyway vive en su propio módulo; sin el starter las migraciones NO se ejecutan
          y ddl-auto=validate falla al arrancar.
        - spring-boot-starter-aop -> spring-boot-starter-aspectj (renombrado en Boot 4).
        - springdoc 2.8.x (Boot 3) -> 3.0.x (Boot 4 / Spring Framework 7).
        - spring-boot-starter-webmvc-test: MockMvc/@WebMvcTest quedaron en módulo propio.
        Verificar con `mvn -B clean verify` (Maven Central no estaba accesible al editar).
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Handler AWS Lambda (seccion 31): misma logica que el consumer RabbitMQ. -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
            <version>1.4.0</version>
        </dependency>

        <!-- Seguridad S2S (paso 31): resource server OAuth2 para el historial. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
